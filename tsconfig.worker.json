{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "webworker"],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src/js/shared-worker.mjs",
    "src/js/sw.js",
    "types/**/*"
  ]
}
