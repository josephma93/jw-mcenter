{
  "name": "jw-mcenter",
  "version": "1.0.0",
  "description": "Local, browser-only multimedia control center for JW meetings. No build step: the browser runs src/ as written.",
  "private": true,
  "scripts": {
    "start": "portless run --name jw-mcenter -- http-server src -c-1 --silent",
    "vendor": "node tools/vendor.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "check:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test": "npm run check && npm run test:unit && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephma93/jw-mcenter.git"
  },
  "license": "ISC",
  "dependencies": {
    "ejs": "^3.1.10",
    "jquery": "^3.7.1",
    "normalize.css": "^8.0.1",
    "rxjs": "^7.8.2",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/ejs": "^3.1.5",
    "@types/jquery": "^3.5.34",
    "@types/node": "^25.9.3",
    "@types/sortablejs": "^1.15.9",
    "esbuild": "^0.28.0",
    "http-server": "^14.1.1",
    "portless": "^0.14.0",
    "typescript": "^6.0.3"
  }
}
